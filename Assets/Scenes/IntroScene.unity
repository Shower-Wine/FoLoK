    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 55
    m_FontStyle: 0
    m_BestFit: 1
    m_MinSize: 0
    m_MaxSize: 100
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "\uC624, \uCC98\uC74C \uBCF4\uB294 \uC5BC\uAD74\uC774\uB124.\n\n\n\uAD1C\uCC2E\uC544,
    \uC790\uC8FC \uBCF4\uAC8C \uB420 \uD14C\uB2C8\uAE4C.\n\n\n\uC6B0\uB9AC\uB294
    \uC0B4\uBA74\uC11C\n\n\uC218\uB9CE\uC740 \uD655\uB960\uC744 \uB9DE\uC774\uD558\uBA70
    \uC0B4\uC9C0.\n\n\n\uADF8\uB798,\n\n\uC6B4\uC774\uB77C\uB294 \uC608\uC05C \uC774\uB984\uC73C\uB85C
    \uBD80\uB974\uC790\uACE0.\n\n\n\uADF8\uB7FC \uD55C \uBC88\uCBE4\uC740 \uAD81\uAE08\uD558\uC9C0
    \uC54A\uC544?\n\n\n\uB108\uC758 \uADF8 \uC6B4, \uC5B4\uB514\uAE4C\uC9C0\uC77C\uAE4C?\n\n\n\uB9CC\uC57D
    \uADF8 \uC6B4\uC5D0\uAC8C\uB3C4 \uC2E0\uC774 \uC788\uB2E4\uBA74\n\n\uC5B4\uB514\uAE4C\uC9C0
    \uB108\uC758 \uD3B8\uC77C\uAE4C?"
